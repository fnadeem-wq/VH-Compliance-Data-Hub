generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Client {
  id                                                      Int            @id @default(autoincrement())
  name                                                    String         @unique
  createdAt                                               DateTime       @default(now())
  companyName                                             String?
  applicableManufacturerOrGpoMakingPaymentId              String?
  submittingApplicableManufacturerOrGpoName               String?
  sourceSystems                                           SourceSystem[]
}

model SourceSystem {
  id             Int             @id @default(autoincrement())
  clientId       Int
  name           String
  createdAt      DateTime        @default(now())
  columnMappings ColumnMapping[]
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadBatches  UploadBatch[]

  @@unique([clientId, name])
}

model ColumnMapping {
  id                Int          @id @default(autoincrement())
  sourceSystemId    Int
  standardizedField String
  rawColumnName     String
  constantValue     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sourceSystem      SourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Cascade)

  @@unique([sourceSystemId, standardizedField, rawColumnName])
}

model UploadBatch {
  id             Int                  @id @default(autoincrement())
  sourceSystemId Int
  fileName       String?
  uploadedAt     DateTime             @default(now())
  records        StandardizedRecord[]
  sourceSystem   SourceSystem         @relation(fields: [sourceSystemId], references: [id], onDelete: Cascade)
}

model StandardizedRecord {
  id                                                      Int         @id @default(autoincrement())
  uploadBatchId                                           Int
  physicianName                                           String?
  physicianNpi                                            String?
  physicianDesignation                                    String?
  transferOfValue                                         String?
  amount                                                  Float?
  date                                                    String?
  companyName                                             String?
  applicableManufacturerOrGpoMakingPaymentId              String?
  submittingApplicableManufacturerOrGpoName               String?
  uploadBatch                                             UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
}

model OrganizationDirectory {
  companyName                                 String  @id @map("Company_Name") @db.VarChar(100)
  applicableManufacturerOrGpoMakingPaymentId  String? @map("Applicable_Manufacturer_or_Applicable_GPO_Making_Payment_ID") @db.VarChar(100)
  submittingApplicableManufacturerOrGpoName   String? @map("Submitting_Applicable_Manufacturer_or_Applicable_GPO_Name") @db.VarChar(100)

  @@map("Organization_Directory")
}
